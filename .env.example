# Copy to .env.local for local use; set the same keys in Vercel for deploys.

# Postgres connection. Leave empty to use the embedded local database (PGlite,
# stored in ./.data). For Supabase use the *transaction pooler* URI
# (Project → Connect → Transaction pooler, port 6543).
DATABASE_URL=

# Signs the login cookie. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Presenter key for the staff and demo screens (/demo, /kds, /counter, /status,
# /admin), their live APIs, the sandbox SMS inbox and staff actions.
# Share links as e.g. https://<app>/demo?key=<DEMO_KEY> — the key is swapped for
# an httpOnly cookie. Unset in development = open; unset in production = closed.
DEMO_KEY=
