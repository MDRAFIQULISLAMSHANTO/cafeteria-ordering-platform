# Copy to .env.local for local use; set the same keys in Vercel for deploys.

# Postgres connection. Leave empty to use the embedded local database (PGlite,
# stored in ./.data). For Supabase use the *transaction pooler* URI
# (Project → Connect → Transaction pooler, port 6543).
DATABASE_URL=

# Signs the login cookie. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Staff and demo screens (/demo, /kds, /counter, /status, /admin), their live
# APIs, the sandbox SMS inbox and staff actions are OPEN by default.
# To lock them behind a presenter key, set DEMO_LOCK=1 and DEMO_KEY; then share
# links as https://<app>/demo?key=<DEMO_KEY> (swapped for an httpOnly cookie).
# DEMO_LOCK=1 without DEMO_KEY keeps them closed.
DEMO_LOCK=
DEMO_KEY=

# Optional: link to the real Odoo POS self-ordering page, shown on the demo hub
# as "Part 2 - production back office". Not connected to this app's data.
NEXT_PUBLIC_ODOO_SELF_ORDER_URL=
